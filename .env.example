EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your-publishable-key         # sb_publishable_… (public, ships in the app bundle)
EXPO_PUBLIC_API_URL=https://your-project.supabase.co/rest/v1
EXPO_PUBLIC_MEDIA_BASE=https://your-media-domain.com  # public CDN base for R2 media


REPLICATE_API_TOKEN=r8_...                           
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id      
R2_ACCESS_KEY_ID=your-r2-access-key-id                
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name
R2_PUBLIC_BASE=https://your-media-domain.com          
SUPABASE_SERVICE_ROLE_KEY=your-secret-key             


EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_DEBUG_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxx.apps.googleusercontent.com

# Required before a public beta release; leave blank for internal builds.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
