{
  "name": "himu",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "expo lint",
    "db:types": "supabase gen types typescript --linked > src/types/database.ts",
    "db:push": "supabase db push",
    "gen:seed": "node --env-file=.env --import tsx scripts/generate/seed.ts",
    "gen:avatars": "node --env-file=.env --import tsx scripts/generate/avatars.ts",
    "gen:covers": "node --env-file=.env --import tsx scripts/generate/covers.ts",
    "gen:music": "node --env-file=.env --import tsx scripts/generate/music.ts",
    "gen:playlists": "node --env-file=.env --import tsx scripts/generate/playlists.ts",
    "gen:cleanup": "node --env-file=.env --import tsx scripts/generate/cleanup.ts",
    "check:creative-generation": "node --import tsx scripts/check/creative-generation-contracts.ts",
    "check:creative-benchmark": "node --import tsx scripts/check/creative-benchmark.ts",
    "benchmark:creative": "node --env-file-if-exists=.env --import tsx scripts/check/run-creative-benchmark.ts",
    "check:creative-generation-migration": "node --import tsx scripts/check/creative-generation-migration.ts",
    "check:creative-media-telemetry": "node --import tsx scripts/check/creative-media-telemetry.ts",
    "check:creative-draft-function": "node --import tsx scripts/check/creative-draft-function.ts",
    "check:creative-model-catalog": "node --import tsx scripts/check/creative-model-catalog.ts",
    "check:creative-provider-adapters": "node --import tsx scripts/check/creative-provider-adapters.ts",
    "check:creative-telemetry": "node --import tsx scripts/check/creative-telemetry.ts",
    "check:creative-titles": "node --import tsx scripts/check/creative-titles.ts",
    "check:dj-performance": "node --import tsx scripts/check/dj-performance.ts",
    "check:generation-brief-v2-migration": "node --import tsx scripts/check/generation-brief-v2-migration.ts",
    "check:music-production": "node --import tsx scripts/check/music-production.ts",
    "check:generation-seasoning": "node --import tsx scripts/check/generation-seasoning.ts",
    "check:visual-direction": "node --import tsx scripts/check/visual-direction.ts",
    "check:himu-experience-state-migration": "node --import tsx scripts/check/himu-experience-state-migration.ts",
    "check:himu-experience-state-function": "node --import tsx scripts/check/himu-experience-state-function.ts",
    "check:himu-product-events-migration": "node --import tsx scripts/check/himu-product-events-migration.ts",
    "check:himu-product-events-function": "node --import tsx scripts/check/himu-product-events-function.ts",
    "check:himu-public-track-function": "node --import tsx scripts/check/himu-public-track-function.ts",
    "check:himu-public-tracks-rls": "node --import tsx scripts/check/himu-public-tracks-rls.ts",
    "check:himu-music-preferences-migration": "node --import tsx scripts/check/himu-music-preferences-migration.ts",
    "check:beta-responsive": "node --import tsx scripts/check/beta-responsive-contract.ts",
    "check:beta-onboarding-browser": "node scripts/check/beta-onboarding-responsive-browser.cjs",
    "check:create-dj-browser": "node scripts/check/create-dj-responsive-browser.cjs",
    "check:settings-browser": "node scripts/check/settings-responsive-browser.cjs",
    "check:beta-visual-browser": "node scripts/check/beta-visual-browser.cjs",
    "check:himu-moment-browser": "node scripts/check/himu-moment-browser.cjs",
    "check:security-remediation-migration": "node --import tsx scripts/check/security-remediation-migration.ts",
    "check:security-quota-invariants": "node --import tsx scripts/check/security-quota-invariants.ts",
    "check:private-media-e2e": "node --import tsx scripts/check/private-media-e2e.ts",
    "migrate:private-media": "node --env-file=.env --import tsx scripts/migrate/private-media-runner.ts",
    "check:web-foundation": "node --import tsx scripts/check/web-foundation.ts",
    "check:web-core-routes": "node --import tsx scripts/check/web-core-routes.ts",
    "check:web-route-matrix": "node --import tsx scripts/check/web-route-matrix.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web",
    "privacy:retention": "node --env-file=.env scripts/privacy/retention.mjs",
    "check:privacy-retention": "node scripts/check/privacy-retention.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "5.0.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.10",
    "expo": "~54.0.33",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "i18next": "^26.3.6",
    "lucide-react-native": "^1.16.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.10",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-unistyles": "^3.2.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^25.8.0",
    "@types/react": "~19.1.0",
    "aws4fetch": "^1.0.20",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "supabase": "^2.98.2",
    "tsx": "^4.22.4",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/.worktrees/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.worktrees/"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|react-native-reanimated|react-native-worklets|react-native-unistyles|react-native-svg)"
    ]
  },
  "private": true
}
